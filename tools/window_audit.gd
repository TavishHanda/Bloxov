extends SceneTree
# Which windows of each building model have something drawn across them (0.25.33, owner picked "open plain windows
# too"): boards nailed over, a cabin's cross-barred sash, the bell tower's stone tracery, a sign over the glass, steel
# bars. Casts a grid of rays through the middle of every window opening against the model's own triangles (0.3 m
# either side of the wall) and writes the share that hit to art_source/buildings/window_audit.json. The map
# generator (tools/gen_old_bloxov.py, shut_windows) leaves a window open to climb through only when that share is
# under its BLOCKED limit; a window this file doesn't list stays shut.
# Re-run after rebuilding a building model, then run the generator:
# godot --headless -s tools/window_audit.gd

const DIR := "res://art_source/buildings/"
const OUT := "res://art_source/buildings/window_audit.json"
const GRID := 9           # rays across and up the window (GRID x GRID)
const SPREAD := 0.6       # over the middle 60% of the opening (broken glass hangs in the corners)
const DEPTH := 0.3        # how far either side of the wall's middle counts as "across the window"
const LAYER := 1 << 19


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	var names: Array[String] = []
	for f in DirAccess.get_files_at(DIR):
		if f.ends_with(".json") and not f.get_basename().get_slice("_", f.get_basename().get_slice_count("_") - 1) in ["solids", "panes", "shots", "audit"]:
			names.append(f.get_basename())
	names.sort()
	var result := {}
	for n in names:
		var glb := "res://assets/models/buildings/%s.glb" % n
		var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(DIR + n + ".json"))
		if not ResourceLoader.exists(glb) or not data is Dictionary:
			continue
		var model: Node3D = (load(glb) as PackedScene).instantiate()
		root.add_child(model)
		var body := StaticBody3D.new()
		body.collision_layer = LAYER
		root.add_child(body)
		for mesh: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
			var shape := CollisionShape3D.new()
			shape.shape = mesh.mesh.create_trimesh_shape()
			(shape.shape as ConcavePolygonShape3D).backface_collision = true
			shape.transform = mesh.global_transform
			body.add_child(shape)
		await physics_frame
		await physics_frame
		var space := body.get_world_3d().direct_space_state
		var shares := {}
		var openings: Array = data.get("openings", [])
		for i in openings.size():
			var o: Dictionary = openings[i]
			if o["kind"] != "window":
				continue
			var ns: bool = o["side"] in "NS"
			var hits := 0
			for ga in GRID:
				for gy in GRID:
					var a: float = o["mid"] + (ga / (GRID - 1.0) - 0.5) * o["w"] * SPREAD
					var y: float = (o["lo"] + o["hi"]) / 2.0 + (gy / (GRID - 1.0) - 0.5) * (o["hi"] - o["lo"]) * SPREAD
					var from := Vector3(a, y, o["at"] - DEPTH) if ns else Vector3(o["at"] - DEPTH, y, a)
					var to := Vector3(a, y, o["at"] + DEPTH) if ns else Vector3(o["at"] + DEPTH, y, a)
					if not space.intersect_ray(PhysicsRayQueryParameters3D.create(from, to, LAYER)).is_empty():
						hits += 1
			shares[str(i)] = roundi(100.0 * hits / (GRID * GRID))
		if not shares.is_empty():
			result[n] = shares
		model.queue_free()
		body.queue_free()
		await physics_frame
	var lines := PackedStringArray()
	for n: String in result:
		lines.append('"%s": %s' % [n, JSON.stringify(result[n])])
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string('{"note": "Generated by tools/window_audit.gd: for each building, window opening number -> the share (%) of '
		+ 'rays through its middle that hit something the model draws across it (boards, bars, a sash, a sign).",\n'
		+ '"windows": {\n' + ",\n".join(lines) + "\n}}\n")
	f.close()
	print("window audit: %d buildings -> %s" % [result.size(), OUT])
	quit()
