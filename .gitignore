# Building models and the kit atlas need their import settings (post-import script swaps in the atlas material).
!assets/models/buildings/*.glb.import
!assets/models/outdoor/*.glb.import
!assets/models/props/cars/*.glb.import
!assets/textures/kit_atlas.png.import
!assets/textures/ground/*.png.import
!assets/textures/water/*.png.import
!assets/textures/trees/*.png.import
