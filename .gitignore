# Godot
.godot/
/build/
export_credentials.cfg
*.translation

# OS
.DS_Store
Thumbs.db

# Blender backups
*.blend1

# Local capture/recording scratch (brag reels, screenshots, temp userdata)
brag-output/

# The local editor plugin that lets an AI drive Godot over a WebSocket. Tooling only, not part of the game, no
# licence file and it opens a local server: keep it off the public repo (reinstall it on a new machine instead).
addons/godot_ai_bridge/

# Generated by the Godot editor/importer on each machine (not committed in this repo)
*.import
*.uid
assets/models/**/*_*.png
tools/.cover_candidates.json
__pycache__/
# Building models and the kit atlas need their import settings (post-import script swaps in the atlas material).
!assets/models/buildings/*.glb.import
!assets/models/outdoor/*.glb.import
!assets/models/movers/*.glb.import
!assets/models/props/cars/*.glb.import
!assets/textures/kit_atlas.png.import
!assets/textures/glass.png.import
!assets/textures/ground/*.png.import
!assets/textures/water/*.png.import
!assets/textures/trees/*.png.import
# The main screen picture: lossy, or the web download carries it uncompressed (~7 MB).
!assets/textures/title_dusk.jpg.import
# Gun look options for the owner (make_gun.py all), not used by the game
assets/models/guns/*_[abc].glb
assets/models/hands/hands_[abc].glb
