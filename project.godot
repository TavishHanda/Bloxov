; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bloxov"
config/description="Blocky voxel extraction shooter."
config/version="0.3.5"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)
]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)
]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)
]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
]
}
heal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":72)
]
}
extracts={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":79)
]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="interactable"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
